# Hosted brain environment. Copy to a secret-store entry or an env file your
# orchestrator mounts. Never commit a filled-in copy.

# --- mode + bind ---
# Forced to `control` by the merv-control entrypoint; set here for
# clarity / when running merv-http directly.
MERV_MODE=control
MERV_HTTP_HOST=0.0.0.0
MERV_HTTP_PORT=8787
# Comma-separated hosted UI origins allowed to call the control API.
MERV_ALLOWED_ORIGINS=https://research-ui.example.com
# UI base for the merv-client login handoff (auth_url). Unlike CORS origins a
# path suffix is allowed (path-mounted UI); unset falls back to the first
# allowed origin, then the API's own origin.
# MERV_UI_BASE_URL=https://rapidreview.io/merv

# --- record store (REQUIRED by hosted startup without an explicit dev root) ---
# A postgres:// or postgresql:// URL selects the Postgres dialect. SQLite is
# only available to the explicit local/dev composition.
#
# Ordinary PostgreSQL and Supabase PostgreSQL use this same interface; Merv
# never imports a Supabase database SDK. Use a dedicated database (ordinary
# PostgreSQL) or dedicated project/stack (Supabase) because Merv currently owns
# tables in `public` and runs DDL migrations at startup. Hosted Supabase must use
# its direct endpoint or session pooler on port 5432 with TLS. Do not use the
# transaction pooler on port 6543: Merv relies on session advisory locks.
MERV_DB_URL=postgresql://USER:PASSWORD@HOST:5432/research_plugin

# --- submitted-byte blob store (REQUIRED by hosted startup) ---
# A bucket name selects the S3 blob store used by the brain for bounded submitted
# bytes. The MCP proxy submits those bytes through private data-plane HTTP routes;
# sandboxes do not use blob presigned URLs. boto3 reads standard AWS_* vars;
# AWS_ENDPOINT_URL_S3 points the brain at MinIO / non-AWS S3 in development.
MERV_BLOB_BUCKET=merv-blobs
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL_S3=http://minio:9000   # dev only (MinIO); unset on real S3

# --- optional heavy-file storage (object store) ---
# Heavy-file storage is separate from the blob store. The storage-specific
# credentials fall back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY when unset.
# MERV_STORAGE_PROVIDER=s3
# MERV_STORAGE_BUCKET=merv-storage
# MERV_STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# MERV_STORAGE_REGION=auto
# MERV_STORAGE_ACCESS_KEY_ID=CHANGE_ME
# MERV_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
# Presigned heavy-storage URLs are dereferenced by client-side MCP proxies (and
# the deploy doctor), so this endpoint must be reachable from those clients.
# MERV_STORAGE_ENDPOINT_URL=https://backend.example.com
# AWS_ENDPOINT_URL_S3 may remain a separate brain-internal blob-store endpoint.

# --- management SSH key (REQUIRED in production) ---
# Mounted private-key FILE + matching public key for brain management
# operations. The control plane reads this key; it never mints one locally when
# these vars are set. The private key must be readable by the control process
# and 0600/0400 (not group/world-readable). To rotate, drain live sandboxes,
# stop control, replace the mounted keypair, and restart. In-place rotation is
# rejected after startup.
MERV_MGMT_KEY_PATH=/run/secrets/research_plugin_mgmt_key/key
# Optional when /run/secrets/research_plugin_mgmt_key/key.pub is mounted.
# MERV_MGMT_PUBLIC_KEY=ssh-ed25519 CHANGE_ME

# --- run-wait signing key (REQUIRED by hosted startup) ---
# Signs the auth-exempt /wait/<sandbox>/<label>/<sig> URLs an agent blocks on to
# learn that a merv_run finished. Hosted control keeps no writable state root,
# so it must be configuration: at least 32 bytes (`openssl rand -hex 32`).
# Rotating it invalidates every wait URL already handed out; callers fall back
# to polling sandbox.runs, so rotation costs latency and nothing else.
MERV_WAIT_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- provider credentials (secret store ONLY in control mode) ---
# In control mode user-machine .env discovery is DISABLED: these must come from
# the provider env file loaded directly by the control service. Point Compose at
# an absolute, host-side file; /dev/null is the record-only default. Set the
# pair(s) for the providers you provision on. Lambda/Thunder deliver HF_TOKEN
# after boot over the management channel; Modal passes it through modal.Secret.
MERV_PROVIDER_ENV_FILE=/absolute/path/to/provider-secrets.env
# Production hosted control should fail startup when the configured sandbox
# backend cannot pass its lightweight health check.
MERV_REQUIRE_SANDBOX_BACKEND=1
MERV_EXECUTION_BACKEND=lambda_labs
# Multi-provider fleets: a comma-separated list configures several providers at
# once behind one multiplexer (agents pick per request with sandbox.request's
# provider field). The single-name var above then selects the default among
# them. One name (or unset) keeps the single-backend path exactly as before.
# MERV_EXECUTION_BACKENDS=lambda_labs,hyperstack,digitalocean
# MERV_LAMBDA_API_KEY=CHANGE_ME
# Hyperstack: environment (made once in the console) pins the region.
# MERV_HYPERSTACK_API_KEY=CHANGE_ME
# MERV_HYPERSTACK_ENVIRONMENT=CHANGE_ME
# DigitalOcean GPU droplets (account needs the one-time GPU unlock).
# MERV_DIGITALOCEAN_TOKEN=CHANGE_ME
# Verda (formerly DataCrunch): OAuth2 client credentials; alias `datacrunch`.
# MERV_VERDA_CLIENT_ID=CHANGE_ME
# MERV_VERDA_CLIENT_SECRET=CHANGE_ME
# AWS EC2 (aliases ec2, amazon): standard AWS credential env; needs boto3.
# Omit the keys to use boto3's default chain (instance profile, SSO, ...).
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME
# MERV_AWS_REGION=us-east-1
# GCP Compute Engine (aliases gce, google): needs google-auth + requests.
# MERV_GCP_PROJECT=CHANGE_ME
# MERV_GCP_ZONE=us-central1-a
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Azure (alias az): service principal from `az ad sp create-for-rbac`.
# MERV_AZURE_TENANT_ID=CHANGE_ME
# MERV_AZURE_CLIENT_ID=CHANGE_ME
# MERV_AZURE_CLIENT_SECRET=CHANGE_ME
# MERV_AZURE_SUBSCRIPTION_ID=CHANGE_ME
# MERV_AZURE_LOCATION=eastus
# MERV_VOLTAGE_PARK_TOKEN=CHANGE_ME
# MERV_TENSORDOCK_TOKEN=CHANGE_ME
# THUNDER_COMPUTE_API_KEY=CHANGE_ME
# MODAL_TOKEN_ID=CHANGE_ME
# MODAL_TOKEN_SECRET=CHANGE_ME
# HF_TOKEN=CHANGE_ME

# --- authentication (Supabase, shared with RapidReview) ---
# The hosted brain verifies the SAME Supabase project RapidReview uses: the
# same accounts sign in to both products, and existing rr_sk_ API keys work.
# SUPABASE_URL + SUPABASE_JWT_SECRET are the two that build a verifier (Supabase
# dashboard, Settings > API); without BOTH, hosted control REFUSES to start. The
# service-role key (RapidReview calls it SUPABASE_KEY) is needed only for rr_sk_
# API-key hash lookups, and the anon key only so the hosted UI can sign users in.
# ROTATE the JWT secret + service key before first use — historical values leaked
# into RapidReview git history.
# MERV_ALLOW_OPEN_CONTROL=1 is the deliberate, loudly logged escape for a
# record-only dev stack. It is parsed STRICTLY: only 1/true/yes/on turn it on and
# only 0/false/no/off turn it off — any other value (a typo like "ture") fails
# the boot instead of being read as permission to open the plane. See
# docs/AUTH.md for the runbook.
MERV_REQUIRE_AUTH=1
# MERV_ALLOW_OPEN_CONTROL=0
# SUPABASE_URL=https://CHANGE_ME.supabase.co
# SUPABASE_JWT_SECRET=CHANGE_ME
# SUPABASE_SERVICE_KEY=CHANGE_ME
# SUPABASE_ANON_KEY=CHANGE_ME
