# Copy to deploy/.env.supabase.local (ignored by git), replace every CHANGE_ME,
# and pass it with `docker compose --env-file deploy/.env.supabase.local ...`.
# Generate URL-safe secrets with: openssl rand -hex 32

# Dedicated self-hosted Supabase database. These variables are intentionally
# named MERV_DB_SUPABASE_* so they cannot be confused with Merv's separate
# production Supabase authentication project below.
MERV_DB_SUPABASE_ADMIN_PASSWORD=CHANGE_ME_HEX_32
MERV_DB_SUPABASE_APP_PASSWORD=CHANGE_ME_HEX_32
MERV_DB_SUPABASE_JWT_SECRET=CHANGE_ME_HEX_32
MERV_DB_SUPABASE_META_CRYPTO_KEY=CHANGE_ME_HEX_32

# Both ports bind to 127.0.0.1 on the Docker host. Keep that default; tunnel
# them over SSH when Docker runs on a remote host.
MERV_DB_SUPABASE_STUDIO_PORT=55433
MERV_DB_SUPABASE_POSTGRES_PORT=55432

# Merv authentication remains on the existing production Supabase project.
# These are not credentials for the database/dashboard above.
MERV_REQUIRE_AUTH=1
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_JWT_SECRET=CHANGE_ME
SUPABASE_SERVICE_KEY=CHANGE_ME
SUPABASE_ANON_KEY=CHANGE_ME


# Independently deployed infrastructure. Provider credentials stay there.
MERV_SANDBOXES_URL=https://sandboxes.example.com
MERV_SANDBOXES_CONNECTIONS_FILE=/secure/merv-sandbox-connections.json
