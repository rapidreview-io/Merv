{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "//": "The render harness and the views it mounts are browser code, compiled by the test runner against @merv/ui's own tsconfig; this server project has neither its DOM lib nor its JSX setting.",
  "exclude": [
    "tests/ui-render.ts",
    "tests/ui-unit.test.ts",
    "tests/ui-artifact-upload.test.ts",
    "tests/ui-pi.test.ts",
    "tests/ui-sessions.test.ts",
    "tests/ui-process.test.ts",
    "tests/ui-code.test.ts",
    "tests/ui-compute.test.ts",
    "tests/ui-experiments.test.ts",
    "tests/ui-feed.test.ts",
    "tests/ui-foundation.test.ts",
    "tests/ui-home.test.ts",
    "tests/ui-home-page.test.ts",
    "tests/ui-agent-live.test.ts",
    "tests/ui-agent-live-lines.test.ts",
    "tests/ui-event-stream-stall.test.ts",
    "tests/ui-cycle-gate-wait.test.ts",
    "tests/ui-agents-gallery.test.ts",
    "tests/ui-json.test.ts",
    "tests/ui-keys.test.ts",
    "tests/ui-markdown.test.ts",
    "tests/ui-needs-you.test.ts",
    "tests/ui-render-files.test.ts",
    "tests/ui-render-harness.test.ts",
    "tests/ui-paper.test.ts",
    "tests/ui-reflections.test.ts",
    "tests/ui-reviews.test.ts",
    "tests/ui-work-map.test.ts",
    "tests/ui-shell.test.ts",
    "tests/ui-tasks.test.ts",
    "tests/ui-record-polls.test.ts",
    "tests/ui-thread.test.ts",
    "tests/ui-threads.test.ts",
    "tests/ui-huggingface.test.ts"
  ]
}
