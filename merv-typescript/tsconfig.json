{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "//": "The render harness and the views it mounts are browser code, compiled by the test runner against @merv/ui's own tsconfig; this server project has neither its DOM lib nor its JSX setting.",
  "exclude": [
    "tests/ui-render.ts",
    "tests/ui-work.test.ts",
    "tests/ui-item-trackio.test.ts",
    "tests/ui-oauth-consent.test.ts",
    "tests/ui-artifact-upload.test.ts",
    "tests/ui-markdown.test.ts",
    "tests/ui-report-chart.test.ts",
    "tests/ui-shell.test.ts",
    "tests/ui-board-pdf-card.test.ts",
    "tests/ui-board-pen-size.test.ts",
    "tests/ui-board-shared.test.ts",
    "tests/ui-merv-panel.test.ts",
    "tests/ui-trail-words.test.ts",
    "tests/ui-page-card-media.test.ts",
    "tests/ui-project-owner-lifecycle.test.ts",
    "tests/ui-voice-lines.test.ts",
    "tests/ui-voice-replay.test.ts",
    "tests/ui-board-input.test.ts",
    "tests/ui-board-touch.test.ts",
    "tests/ui-board-pages.test.ts",
    "tests/ui-board-replay-words.test.ts",
    "tests/ui-voice-backends.test.ts"
  ]
}
