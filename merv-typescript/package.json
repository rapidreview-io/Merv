{
  "name": "merv-typescript",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/build-board-renderer.mjs && node --import tsx scripts/copy-runtime-assets.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "node scripts/test-schemas.mjs 6",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:sweep": "node scripts/test-schemas.mjs",
    "start": "node --import tsx src/cli.ts serve",
    "init": "node --import tsx src/cli.ts init",
    "cli": "node --import tsx src/cli.ts",
    "test:live": "node --import tsx scripts/live-codex.ts",
    "test:live:sessions": "node --import tsx scripts/live-sessions.ts",
    "test:live:dispatch": "node --import tsx scripts/live-sessions.ts --automatic",
    "test:sessions": "node --import tsx --test tests/sessions.test.ts tests/sessions-api.test.ts tests/sessions-integration.test.ts tests/workflow-leases.test.ts tests/workflow-dispatch.test.ts tests/session-dispatch-api.test.ts",
    "test:runner": "node --import tsx --test tests/runner-*.test.ts",
    "test:deploy": "node --test deploy/*.test.mjs scripts/hosted-runner/*.test.mjs",
    "test:feed-unload": "node --import tsx scripts/feed-unload.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:credentials": "node --import tsx --test tests/remote-permissions.test.ts tests/mount-upstream.test.ts",
    "test:mount-unload": "node --import tsx scripts/mount-unload.ts",
    "test:mounts": "node --import tsx --test tests/mounts.test.ts tests/mount-config.test.ts tests/mount-unload.test.ts",
    "build:ui": "npm run build --workspace @merv/ui",
    "typecheck:ui": "npm run typecheck --workspace @merv/ui",
    "dev:ui": "npm run dev --workspace @merv/ui",
    "test:ui": "node --import tsx --test tests/ui*.test.ts",
    "demo:ui": "node --import tsx scripts/ui-demo.ts",
    "docs:architecture": "node --import tsx scripts/dependency-map.ts",
    "postinstall": "patch-package --patch-dir vendor/merv-sandboxes/typescript/patches && node scripts/patch-excalidraw-hyperlink.mjs",
    "build:board-renderer": "node scripts/build-board-renderer.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3",
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/client-ssm": "^3",
    "@aws-sdk/client-sts": "^3",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@sandboxes/access": "file:vendor/merv-sandboxes/typescript/packages/access",
    "@sandboxes/accounts": "file:vendor/merv-sandboxes/typescript/packages/accounts",
    "@sandboxes/auth": "file:vendor/merv-sandboxes/typescript/packages/auth",
    "@sandboxes/billing": "file:vendor/merv-sandboxes/typescript/packages/billing",
    "@sandboxes/composition": "file:vendor/merv-sandboxes/typescript/packages/composition",
    "@sandboxes/db": "file:vendor/merv-sandboxes/typescript/packages/db",
    "@sandboxes/http": "file:vendor/merv-sandboxes/typescript/packages/http",
    "@sandboxes/jobs": "file:vendor/merv-sandboxes/typescript/packages/jobs",
    "@sandboxes/kernel": "file:vendor/merv-sandboxes/typescript/packages/kernel",
    "@sandboxes/merv-host": "file:vendor/merv-sandboxes/typescript/hosts/merv",
    "@sandboxes/pipelines": "file:vendor/merv-sandboxes/typescript/packages/pipelines",
    "@sandboxes/providers": "file:vendor/merv-sandboxes/typescript/packages/providers",
    "@sandboxes/registry": "file:vendor/merv-sandboxes/typescript/packages/registry",
    "@sandboxes/runtimes": "file:vendor/merv-sandboxes/typescript/packages/runtimes",
    "@sandboxes/ssh": "file:vendor/merv-sandboxes/typescript/packages/ssh",
    "@sandboxes/storage": "file:vendor/merv-sandboxes/typescript/packages/storage",
    "@smithy/node-http-handler": "^4",
    "cordis": "4.0.0-rc.10",
    "decimal.js": "^10.5.0",
    "modal": "0.11.0",
    "patch-package": "^8",
    "pg": "^8.23.0",
    "smol-toml": "^1.3.0",
    "ssh2": "1.17.0",
    "tsx": "^4.20.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.18.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "typescript": "^5.9.0"
  },
  "packageManager": "npm@11.1.0"
}
