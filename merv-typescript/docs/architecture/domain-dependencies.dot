digraph G { graph [rankdir=TB, bgcolor="transparent", fontname="Arial", pad="0.18", nodesep="0.25", ranksep="0.75", splines=polyline, outputorder=edgesfirst]; node [shape=box,style="rounded,filled",fontname="Arial",margin="0.18,0.14",penwidth=1.6]; edge [penwidth=1.6, arrowsize=0.65];
state [id="node-state", color="#2365B5",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>State</B></FONT><BR/><FONT POINT-SIZE="12">SQLite transactions + events</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: none</FONT>>];
blobs [id="node-blobs", color="#718096",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>Blobs</B></FONT><BR/><FONT POINT-SIZE="12">Local evidence bytes</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: none</FONT>>];
scope [id="node-scope", color="#A76013",fillcolor="#FFF9ED",label=<<FONT POINT-SIZE="21"><B>Scope</B></FONT><BR/><FONT POINT-SIZE="12">Users, memberships + actors</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State</FONT>>];
claims [id="node-claims", color="#815E97",fillcolor="#FBF7FF",label=<<FONT POINT-SIZE="21"><B>Claims</B></FONT><BR/><FONT POINT-SIZE="12">Research statements + confidence</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State, Scope</FONT>>];
artifacts [id="node-artifacts", color="#1C8480",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>Artifacts</B></FONT><BR/><FONT POINT-SIZE="12">Evidence metadata</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State, Scope, Blobs</FONT>>];
workflows [id="node-workflows", color="#326B90",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>Workflows</B></FONT><BR/><FONT POINT-SIZE="12">States + transitions</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State, Scope</FONT>>];
reviews [id="node-reviews", color="#4A7793",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>Reviews</B></FONT><BR/><FONT POINT-SIZE="12">Independent verdicts</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State, Scope, Artifacts, Domain Events</FONT>>];
tasks [id="node-tasks", color="#246E78",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>Tasks</B></FONT><BR/><FONT POINT-SIZE="12">Task program</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State, Scope, Artifacts,<BR/>Workflows, Reviews, Context Builder</FONT>>];
experiments [id="node-experiments", color="#815E97",fillcolor="#FBF7FF",label=<<FONT POINT-SIZE="21"><B>Experiments</B></FONT><BR/><FONT POINT-SIZE="12">Plans, attempts + evidence</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State, Scope, Claims, Artifacts,<BR/>Workflows, Reviews, Context Builder, Paper<BR/>Optional: Code for Git</FONT>>];
knowledge [id="node-knowledge", color="#7B529B",fillcolor="#FBF7FF",label=<<FONT POINT-SIZE="21"><B>Knowledge</B></FONT><BR/><FONT POINT-SIZE="12">Project records + reference queries</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State, Scope, Claims, Tasks,<BR/>Experiments, Artifacts, Reviews<BR/>Optional: Code captures</FONT>>];
code [id="node-code",color="#287D71",fillcolor="#EDFAF6",label=<<FONT POINT-SIZE="18"><B>Code</B></FONT><BR/><FONT POINT-SIZE="11">Shared provider reference</FONT>>];
feed [id="node-feed", color="#2D8F84",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>Feed</B></FONT><BR/><FONT POINT-SIZE="12">Project posts + activity</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State, Scope, Artifacts</FONT>>];
domainEvents [id="node-domainEvents", color="#BB7347",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>Domain Events</B></FONT><BR/><FONT POINT-SIZE="12">Durable delivery + retries</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State</FONT>>];
contextBuilder [id="node-contextBuilder", color="#208B78",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>Context Builder</B></FONT><BR/><FONT POINT-SIZE="12">Versioned context recipes</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: State, Scope, Artifacts</FONT>>];
