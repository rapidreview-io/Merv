digraph G { graph [rankdir=TB, bgcolor="transparent", fontname="Arial", pad="0.18", nodesep="0.25", ranksep="0.75", splines=polyline, outputorder=edgesfirst]; node [shape=box,style="rounded,filled",fontname="Arial",margin="0.18,0.14",penwidth=1.6]; edge [penwidth=1.6, arrowsize=0.65];
tools [id="node-tools", color="#5B40BD",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>Tools</B></FONT><BR/><FONT POINT-SIZE="12">Tool registry</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: Scope</FONT>>];
api [id="node-api", color="#4A70BC",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>API</B></FONT><BR/><FONT POINT-SIZE="12">HTTP + MCP</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: Scope, Tools, Identity</FONT>>];
identity [id="node-identity", color="#198778",fillcolor="#EDFAF6",label=<<FONT POINT-SIZE="21"><B>Identity</B></FONT><BR/><FONT POINT-SIZE="12">Verifies shared user login</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: none</FONT>>];
mounts [id="node-mounts", color="#6650AA",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>External Mounts</B></FONT><BR/><FONT POINT-SIZE="12">MCP connections + credentials</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: Tools, Scope</FONT><BR/><FONT COLOR="#65539B" POINT-SIZE="11">OPTIONAL</FONT>>];
ui [id="node-ui", color="#846AC4",fillcolor="#F6FAFF",label=<<FONT POINT-SIZE="21"><B>UI</B></FONT><BR/><FONT POINT-SIZE="12">Browser shell + UI registry</FONT><BR/><BR/><FONT POINT-SIZE="12">Requires: API, Tools</FONT>>];
scope [id="node-scope", color="#A76013",fillcolor="#FFF9ED",label=<<FONT POINT-SIZE="21"><B>Scope</B></FONT><BR/><FONT POINT-SIZE="12">Project authorization</FONT><BR/><BR/><FONT POINT-SIZE="12">Same Scope service as left panel</FONT>>];
tools -> scope [id="edge-tools-scope",color="#A76013"];
api -> scope [id="edge-api-scope",color="#A76013"];
api -> tools [id="edge-api-tools",color="#5B40BD"];
api -> identity [id="edge-api-identity",color="#198778"];
mounts -> tools [id="edge-mounts-tools",color="#5B40BD"];
mounts -> scope [id="edge-mounts-scope",color="#9356A6"];
ui -> api [id="edge-ui-api",color="#4A70BC"];
ui -> tools [id="edge-ui-tools",color="#5B40BD"];
{rank=same;api;mounts;}}
