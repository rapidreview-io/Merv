+test('PostgreSQL project writers overlap but exclude same-project and global writers', postgres, async (t) => {
+  const { state, schema } = await fixture(t);
+  const other = await PostgresState.open({
+    connectionString: connectionString!, schema, lockTimeoutMs: 30, maxConnections: 1,
+  });
+  t.after(() => other.close());
+  for (const projectId of ['project', undefined]) {
+    const entered = deferred(), release = deferred();
+    const held = state.transaction(async () => {
+      entered.resolve();
+      await release.promise;
+    }, { projectId });
+    try {
+      await entered.promise;
+      if (projectId !== undefined) {
+        const saved = await other.transaction(
+          (tx) => other.appendEvent(tx, { ...event, projectId: 'other' }),
+          { projectId: 'other' },
+        );
+        assert.ok(saved.id > 0, 'Another project commits while the first writer is still open');
+      }
+      await assert.rejects(other.transaction(() => undefined, { projectId: 'project' }), {
+        code: 'state_timeout',
+      });
+      await assert.rejects(other.transaction(() => undefined), { code: 'state_timeout' });
+    } finally {
+      release.resolve();
+      await held;
+    }
+    // Timed-out BEGINs release both the connection and any shared schema gate.
+    await other.transaction(() => undefined, { projectId: 'project' });
+    await other.transaction(() => undefined);
+  }
+});
+
+test('PostgreSQL project event appends remain globally commit-ordered, including rollback gaps', postgres, async (t) => {
+  const { state, schema } = await fixture(t);
+  const other = await PostgresState.open({
+    connectionString: connectionString!, schema, lockTimeoutMs: 30,
+  });
+  t.after(() => other.close());
+  const entered = deferred(), release = deferred();
+  const first = state.transaction(async (tx) => {
+    const saved = await state.appendEvent(tx, event);
+    entered.resolve();
+    await release.promise;
+    return saved;
+  }, { projectId: 'project' });
+  let secondEntered = false;
+  try {
+    await entered.promise;
+    await assert.rejects(other.transaction(async (tx) => {
+      secondEntered = true;
+      await other.appendEvent(tx, { ...event, projectId: 'other' });
+    }, { projectId: 'other' }), { code: 'state_timeout' });
+    assert.equal(secondEntered, true, 'The other project waits only when it appends an event');
+    assert.equal(await other.eventHead(), 0);
+    assert.deepEqual(await other.eventBatch(0, 10), []);
+  } finally {
+    release.resolve();
+    await first;
+  }
+  const one = await first;
+  await assert.rejects(other.transaction(async (tx) => {
+    await other.appendEvent(tx, { ...event, projectId: 'other' });
+    throw new Error('rollback');
+  }, { projectId: 'other' }), /rollback/);
+  const two = await other.transaction(
+    (tx) => other.appendEvent(tx, { ...event, projectId: 'other' }),
+    { projectId: 'other' },
+  );
+  assert.ok(two.id > one.id + 1);
+  assert.deepEqual((await state.eventBatch(one.id, 10)).map(({ id }) => id), [two.id]);
+  assert.equal(await state.eventHead(), two.id);
+});
