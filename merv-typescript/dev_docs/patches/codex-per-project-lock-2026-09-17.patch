+test('PostgreSQL project locks retain the schema gate and defer global event serialization', async (t) => {
+  const queries: { sql: string; params: unknown[] }[] = [];
+  t.mock.method(Pool.prototype, 'connect', async () => ({
+    query: async (sql: string, params: unknown[] = []) => {
+      queries.push({ sql, params });
+      return { rows: [{ exists: 1, id: 1 }], command: sql, rowCount: 1 };
+    },
+    release() {},
+  }) as unknown as PoolClient);
+  const state = await PostgresState.open({
+    connectionString: 'postgres://unused/unused',
+    schema: 'lock_test',
+  });
+  t.after(() => state.close());
+  const locks = () => queries.filter(({ sql }) => sql.includes('pg_advisory_xact_lock'));
+  const lock = (key: string, shared = false) => ({
+    sql: `SELECT pg_catalog.pg_advisory_xact_lock${shared ? '_shared' : ''}(pg_catalog.hashtextextended($1, 0))`,
+    params: [key],
+  });
+  assert.deepEqual(locks(), [lock('merv-state:lock_test')], 'Initialization stays exclusive');
+  for (const projectId of [undefined, 'project', 'other']) {
+    queries.length = 0;
+    // Exercise the path that reuses a read connection, as Sessions does.
+    await state.read(() => state.transaction(async (tx) => {
+      assert.equal(tx.projectId, projectId);
+      assert.equal(queries.some(({ sql }) => sql === 'BEGIN'), true);
+      assert.deepEqual(locks(), [
+        lock('merv-state:lock_test', projectId !== undefined),
+        ...(projectId === undefined ? [] : [lock(`merv-state:lock_test:${projectId}`)]),
+      ]);
+      if (projectId !== undefined) {
+        await assert.rejects(inTransaction(state, tx, () => undefined, { projectId: 'wrong' }), {
+          code: 'transaction_project_mismatch',
+        });
+        await assert.rejects(state.appendEvent(tx, { ...event, projectId: 'wrong' }), {
+          code: 'transaction_project_mismatch',
+        });
+      }
+      await state.appendEvent(tx, { ...event, projectId: projectId ?? 'project' });
+      await state.appendEvent(tx, { ...event, projectId: projectId ?? 'project' });
+      assert.deepEqual(locks().at(-1), lock('merv-events:lock_test'));
+      assert.equal(locks().filter(({ params }) => params[0] === 'merv-events:lock_test').length, 1);
+      const eventLock = queries.findIndex(({ params }) => params[0] === 'merv-events:lock_test');
+      assert.ok(queries.findIndex(({ sql }) => sql.startsWith('INSERT INTO events')) > eventLock);
+    }, { projectId }));
+    assert.equal(queries.at(-1)!.sql, 'COMMIT');
+  }
+  queries.length = 0;
+  await state.snapshot(() => state.transaction(async (tx) => {
+    await tx.get('SELECT 1');
+    await assert.rejects(state.appendEvent(tx, event), { code: 'read_only_scope' });
+  }, { projectId: 'project' }));
+  assert.deepEqual(locks(), [], 'Read snapshots still bypass writer locks');
+  await assert.rejects(state.transaction(() => undefined, { projectId: '' }), {
+    code: 'invalid_project',
+  });
+});
