[Unit]
Description=Resume Merv after interrupted offline recovery capture
Requires=docker.service
After=docker.service
Before=recovery-snapshot.service
OnFailure=recovery-snapshot-alert.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/merv-recovery/recovery-snapshot.py --config /etc/merv/recovery.json recover
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
