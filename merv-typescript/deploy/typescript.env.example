# Install an independently prepared copy as /etc/merv/typescript.env, root:root 0600.
# Values below are placeholders, never production credentials.
MERV_DB_URL=postgresql://merv_ts_app:CHANGE_ME@deploy-supabase-db-1:5432/postgres
# Optional; rehearsal/final candidates use administrator-created merv_ts_* schemas.
MERV_TS_DB_SCHEMA=merv_ts
MERV_BLOB_BUCKET=CHANGE_ME
MERV_BLOB_ENDPOINT_URL=https://CHANGE_ME.r2.cloudflarestorage.com
MERV_BLOB_ACCESS_KEY_ID=CHANGE_ME
MERV_BLOB_SECRET_ACCESS_KEY=CHANGE_ME
MERV_BLOB_REGION=auto
MERV_BLOB_PREFIX=merv-ts
SUPABASE_URL=https://emoimoycgytvcixzgjiy.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
# Select only after verifying the project's CURRENT user JWT signing mode.
MERV_TS_AUTH_MODE=CHANGE_ME
# Required only for hs256; omit for jwks. Never give the UI a service-role key.
SUPABASE_JWT_SECRET=CHANGE_ME
MERV_TS_PUBLIC_ORIGIN=https://experiments.rapidreview.io
# Set only after foundation + historical import of this exact sourceId has passed.
# MERV_TS_LEGACY_SOURCE_ID=SOURCE_SNAPSHOT_ID

# Optional merv-sandboxes connection: sidebar rows, sandbox.extend and sandbox.release.
# Leave MERV_SANDBOXES_URL unset to compose no sandboxes plugins at all.
# MERV_SANDBOXES_URL is the service origin (https, no path, query or credentials) and the only
# origin the plugin ever calls. MERV_SANDBOXES_CONNECTIONS is a JSON array with one entry per
# project; tokenEnv names the variable holding that project's sbxt_ consumer grant, which is
# read from the environment on every request. Never put a grant in this array; rendering refuses
# an entry whose variable is unset or not an sbxt_ grant. Projects, the Pi host among them, are
# connected with deploy/pi-connect-project.py (deploy/PI_OPERATIONS.md).
# MERV_SANDBOXES_URL=https://sandboxes.example
# MERV_SANDBOXES_CONNECTIONS=[{"projectId":"project_example","namespace":"research","tokenEnv":"MERV_SANDBOXES_TOKEN"}]
# MERV_SANDBOXES_TOKEN=CHANGE_ME

# Written by the one-time `pi-connect-project.py ml --ceiling 10000` phase.
# New projects use this one consumer grant with their project ID as the application subject.
# MERV_SANDBOXES_ML_NAMESPACE=merv-ml
# MERV_SANDBOXES_ML_TOKEN=CHANGE_ME
# MERV_SANDBOXES_ML_SINCE=2026-09-25T00:00:00+00:00
# MERV_SANDBOXES_ML_STORAGE_ORIGIN=https://objects.example

# Optional hosted Fleet. This requires the protected runtime release and launch grant to be
# installed in merv-sandboxes, plus a matching fixed Cloudflare offer. Omit all Fleet variables
# to preserve the ordinary external-runner deployment. This only renders configuration; it
# does not deploy an image or run provider acceptance.
# MERV_FLEET_ENABLED=true
# The machines Fleet may rent, the default first: each is one Sandboxes runtime profile and one
# machine a person may run Pi on. label is what the Agent page shows, slots how many turns share
# the machine at once (1-8), agent whether the agent may move itself there. ttlSeconds is optional.
# MERV_FLEET_RUNTIMES='[{"key":"standard","label":"Standard","slots":3,"provider":"cloudflare-fleet","offerId":"standard-1:cloudflare","releaseId":"rt1_REPLACE","leaseSeconds":900},{"key":"large","label":"Large","slots":4,"agent":true,"provider":"cloudflare-fleet-large","offerId":"standard-3:cloudflare","releaseId":"rt1_REPLACE","leaseSeconds":900}]'
# Without MERV_FLEET_RUNTIMES these four render as the one machine "standard" (3 slots). With it
# they are ignored, and kept only so an image older than the catalog can still render.
# MERV_FLEET_RUNTIME_PROVIDER=cloudflare
# MERV_FLEET_RUNTIME_OFFER_ID=standard-1:cloudflare
# MERV_FLEET_RUNTIME_RELEASE_ID=rt1_REPLACE_WITH_64_LOWERCASE_HEX_DIGITS
# MERV_FLEET_RUNTIME_LEASE_SECONDS=900
# MERV_FLEET_MANAGED_SECRET_ENV=MERV_FLEET_MANAGED_SECRET
# MERV_FLEET_MANAGED_SECRET=CHANGE_ME_AT_LEAST_32_BYTES
# MERV_FLEET_GLOBAL_LIMIT=50
# MERV_FLEET_PROJECT_LIMIT=5
# Caps that replace MERV_FLEET_PROJECT_LIMIT for the named projects (1-64 each). The Pi host
# rents every Pi machine, so it needs its own.
# MERV_FLEET_PROJECT_LIMITS='{"project_pi_host":50}'
# The connected project through which a Fleet owner that rents in the host rents for projects
# without their own connection. Defaults to MERV_PI_HOST_PROJECT_ID.
# MERV_FLEET_HOST_PROJECT_ID=project_pi_host
# One allocation's hard deadline, independent of the renewable sandbox lease; valid range 60–86400.
# MERV_FLEET_ALLOCATION_TIMEOUT_SECONDS=86400
# Optional workflow owner: omit these to leave Fleet without automatic workflow demand.
# It serves every project whose admin turned dispatch on for Fleet, acting as that admin, while
# the admin is one of PEOPLE: sign-in identities as "issuer subject", or ["*"] for anyone once
# sign-up is closed. Projects without their own connection rent through the host project.
# The model API key stays in a named environment variable, never in the rendered JSON.
# MERV_FLEET_WORKFLOW_ENABLED=true
# MERV_FLEET_WORKFLOW_PEOPLE='["https://example.supabase.co/auth/v1 00000000-0000-0000-0000-000000000000"]'
# MERV_FLEET_WORKFLOW_MODEL_API_KEY_ENV=MERV_FLEET_MODEL_API_KEY
# MERV_FLEET_WORKFLOW_BASE_URL=https://experiments.rapidreview.io
# Machines in total, across projects; valid range 1–64.
# MERV_FLEET_WORKFLOW_MAX_AGENTS=10
# The model key never leaves Main: hosted Codex calls the model through Main's /codex-model relay,
# which refuses a person's further calls once their tokens for the UTC day reach this ceiling.
# MERV_FLEET_WORKFLOW_DAILY_TOKENS_PER_PERSON=20000000
# MERV_FLEET_MODEL_API_KEY=CHANGE_ME

# Optional read-only Agent sidebar; requires Fleet and a verified Pi-capable runtime release.
# MERV_PI_ENABLED=true
# MERV_PI_SECRET_ENV=MERV_PI_SECRET
# MERV_PI_SECRET=CHANGE_ME_AT_LEAST_32_BYTES
# MERV_PI_MODEL_API_KEY_ENV=MERV_PI_MODEL_API_KEY
# MERV_PI_MODEL_API_KEY=CHANGE_ME
# The models a person may pick per conversation, the first the default; labels only are shown.
# Reasoning models only, each with the effort the relay sets (none or low). Unset: GPT-6 Luna.
# MERV_PI_MODELS=[{"id":"gpt-6-luna","label":"GPT-6 Luna","inputUsdPerM":0.1,"outputUsdPerM":0.5,"effort":"none"}]
# A turn ends after this long without progress: to reach its machine, then between words or tool
# calls. A turn still answering runs on, up to a three-hour ceiling.
# MERV_PI_TURN_TIMEOUT_SECONDS=300
# A person's machine in a project stops this long after the last answer in any of their
# conversations there.
# MERV_PI_IDLE_TIMEOUT_SECONDS=600
# The Pi host: one operator-owned project whose reader key rents every Pi machine. It needs its
# own MERV_SANDBOXES_CONNECTIONS entry, and rendering refuses Pi without both. Every read the
# agent makes still runs as the person. deploy/pi-connect-project.py creates and connects it.
# MERV_PI_HOST_PROJECT_ID=project_pi_host
# MERV_PI_HOST_KEY_ENV=MERV_PI_HOST_KEY
# MERV_PI_HOST_KEY=CHANGE_ME
# One machine per person per project (project, the default), or per person (person).
# MERV_PI_RUNTIME_KEY=project
# Let the agent move itself (switch_machine) to a machine marked agent in MERV_FLEET_RUNTIMES,
# where its person could choose that machine.
# MERV_PI_AGENT_MOVES=true

# Optional internet search for every agent (web.search, web.extract), as Nisa's agents search.
# Leave both MERV_TAVILY_API_KEY and MERV_WEB_FALLBACK_KEY_ENV unset to compose nothing; an image
# older than @merv/web ignores them. Rendering refuses a Tavily key that is not tvly-… and never
# copies a key. Activation: packages/web/README.md, "Turning it on".
# MERV_TAVILY_API_KEY=CHANGE_ME
# Optional fallback to OpenAI's hosted web search when Tavily has no key or refuses it: the NAME
# of the variable holding an OpenAI key (Pi's serves), and the Responses model to use.
# MERV_WEB_FALLBACK_KEY_ENV=MERV_PI_MODEL_API_KEY
# MERV_WEB_FALLBACK_MODEL=gpt-6-luna
# Calls per UTC day: one project's (1-100000), the whole deployment's (1-1000000), and the
# deployment's fallback searches, each a grounded model call (1-1000000, with a fallback only).
# Calls Main has in flight (1-64), half of them for any one project. Every Fleet agent in a
# project shares its day with that project's Pi: with MERV_FLEET_WORKFLOW_ENABLED, raise the
# project's day to about MERV_FLEET_PROJECT_LIMIT x calls per step x steps a day (five agents at
# 20 calls a step spend 200 in two steps), and the deployment's with it.
# MERV_WEB_DAILY_CALLS_PER_PROJECT=200
# MERV_WEB_DAILY_CALLS=1000
# MERV_WEB_FALLBACK_DAILY_CALLS=200
# MERV_WEB_MAX_IN_FLIGHT=8

# Optional literature search for every agent (nisa.search, nisa.semantic_search, nisa.paper,
# nisa.excerpts, nisa.related) over Nisa's public API. Leave MERV_NISA_API_KEY unset to compose
# nothing; an image older than @merv/nisa ignores it. Rendering refuses a key that is not
# rr_sk_… and never copies it. Activation: docs/NISA_PLUGIN.md.
# MERV_NISA_API_KEY=CHANGE_ME
# Optional: another Nisa, by its https origin.
# MERV_NISA_ORIGIN=https://api.rapidreview.io

# Optional GitHub repository connection inside Code. Leave all four unset to disable.
# MERV_GITHUB_APP_SLUG=your-app-slug
# MERV_GITHUB_CLIENT_ID=your-app-client-id
# MERV_GITHUB_CLIENT_SECRET=CHANGE_ME
# MERV_GITHUB_ENCRYPTION_KEY=CHANGE_ME_64_HEXADECIMAL_CHARACTERS
# Optional automation: server-held RSA PEM key encoded as base64. Keep this secret.
# Requires explicit per-project consent and App repository permissions documented in GITHUB_REPOSITORIES.md.
# MERV_GITHUB_PRIVATE_KEY_BASE64=CHANGE_ME
