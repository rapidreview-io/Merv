# Install an independently prepared copy as /etc/merv/typescript.env, root:root 0600.
# Values below are placeholders, never production credentials.
MERV_DB_URL=postgresql://merv_ts_app:CHANGE_ME@deploy-supabase-db-1:5432/postgres
# Optional; rehearsal/final candidates use administrator-created merv_ts_* schemas.
MERV_TS_DB_SCHEMA=merv_ts
MERV_BLOB_BUCKET=CHANGE_ME
MERV_BLOB_ENDPOINT_URL=https://CHANGE_ME.r2.cloudflarestorage.com
MERV_BLOB_ACCESS_KEY_ID=CHANGE_ME
MERV_BLOB_SECRET_ACCESS_KEY=CHANGE_ME
MERV_BLOB_REGION=auto
MERV_BLOB_PREFIX=merv-ts
SUPABASE_URL=https://emoimoycgytvcixzgjiy.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
# Select only after verifying the project's CURRENT user JWT signing mode.
MERV_TS_AUTH_MODE=CHANGE_ME
# Required only for hs256; omit for jwks. Never give the UI a service-role key.
SUPABASE_JWT_SECRET=CHANGE_ME
MERV_TS_PUBLIC_ORIGIN=https://experiments.rapidreview.io
# Set only after foundation + historical import of this exact sourceId has passed.
# MERV_TS_LEGACY_SOURCE_ID=SOURCE_SNAPSHOT_ID

# Optional merv-sandboxes connection: sidebar rows, sandbox.extend and sandbox.release.
# Leave MERV_SANDBOXES_URL unset to compose no sandboxes plugins at all.
# MERV_SANDBOXES_URL is the service origin (https, no path, query or credentials) and the only
# origin the plugin ever calls. MERV_SANDBOXES_CONNECTIONS is a JSON array with one entry per
# project; tokenEnv names the variable holding that project's sbxt_ consumer grant, which is
# read from the environment on every request. Never put a grant in this array.
# MERV_SANDBOXES_URL=https://sandboxes.example
# MERV_SANDBOXES_CONNECTIONS=[{"projectId":"project_example","namespace":"research","tokenEnv":"MERV_SANDBOXES_TOKEN"}]
# MERV_SANDBOXES_TOKEN=CHANGE_ME

# Optional hosted Fleet. This requires the protected runtime release and launch grant to be
# installed in merv-sandboxes, plus a matching fixed Cloudflare offer. Omit all Fleet variables
# to preserve the ordinary external-runner deployment. This only renders configuration; it
# does not deploy an image or run provider acceptance.
# MERV_FLEET_ENABLED=true
# MERV_FLEET_RUNTIME_PROVIDER=cloudflare
# MERV_FLEET_RUNTIME_OFFER_ID=standard-1:cloudflare
# MERV_FLEET_RUNTIME_RELEASE_ID=rt1_REPLACE_WITH_64_LOWERCASE_HEX_DIGITS
# MERV_FLEET_RUNTIME_LEASE_SECONDS=900
# MERV_FLEET_MANAGED_SECRET_ENV=MERV_FLEET_MANAGED_SECRET
# MERV_FLEET_MANAGED_SECRET=CHANGE_ME_AT_LEAST_32_BYTES
# MERV_FLEET_GLOBAL_LIMIT=3
# MERV_FLEET_PROJECT_LIMIT=1
# Optional workflow owner: omit these to leave Fleet without automatic workflow demand.
# The source credential and model API key stay in named environment variables, never in the
# rendered JSON. The project must have a matching MERV_SANDBOXES_CONNECTIONS entry.
# MERV_FLEET_WORKFLOW_ENABLED=true
# MERV_FLEET_WORKFLOW_PROJECT_ID=project_example
# MERV_FLEET_WORKFLOW_SOURCE_CREDENTIAL_ENV=MERV_FLEET_SOURCE_CREDENTIAL
# MERV_FLEET_WORKFLOW_MODEL_API_KEY_ENV=MERV_FLEET_MODEL_API_KEY
# MERV_FLEET_WORKFLOW_BASE_URL=https://experiments.rapidreview.io
# MERV_FLEET_SOURCE_CREDENTIAL=CHANGE_ME
# MERV_FLEET_MODEL_API_KEY=CHANGE_ME

# Optional GitHub repository connection inside Code. Leave all four unset to disable.
# MERV_GITHUB_APP_SLUG=your-app-slug
# MERV_GITHUB_CLIENT_ID=your-app-client-id
# MERV_GITHUB_CLIENT_SECRET=CHANGE_ME
# MERV_GITHUB_ENCRYPTION_KEY=CHANGE_ME_64_HEXADECIMAL_CHARACTERS
# Optional automation: server-held RSA PEM key encoded as base64. Keep this secret.
# Requires explicit per-project consent and App repository permissions documented in GITHUB_REPOSITORIES.md.
# MERV_GITHUB_PRIVATE_KEY_BASE64=CHANGE_ME
