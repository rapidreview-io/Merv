diff --git a/control/tests/test_managed_connections.py b/control/tests/test_managed_connections.py
new file mode 100644
index 0000000..adff575
--- /dev/null
+++ b/control/tests/test_managed_connections.py
@@ -0,0 +1,165 @@
+"""Managed project roots share an account subject's aggregate allowance."""
+
+import asyncio
+from decimal import Decimal
+
+import pytest
+
+from merv_sandboxes.auth.tokens import hash_token
+from merv_sandboxes.billing import Policy
+from merv_sandboxes.errors import AuthorizationError, ValidationError
+from merv_sandboxes.models import Money
+from merv_sandboxes.registry import CreateSandboxRequest
+
+from .test_delegation import assignment
+
+
+async def managed(container, client):
+    grant = await container.tokens.create(
+        namespace="managed", application_id="merv-ml", open_subjects=True
+    )
+    first = await container.tokens.authenticate(grant.secret, subject="account-a")
+    await container.registry.billing.set_policy(
+        first.account_id,
+        "account-allowance",
+        Policy(scope="member_default", target=first.account_id, window="month", cap=Decimal(500)),
+    )
+    container.settings.managed_delegation_grants = (grant.token_id,)
+    client.headers.update(
+        {
+            "Authorization": "Bearer " + grant.secret,
+            "X-Sandbox-Namespace": "managed",
+            "X-Sandbox-Subject": "account-a",
+        }
+    )
+    return grant, first
+
+
+async def root(client, project):
+    bearer = "sbxt_managed_connection_" + project
+    body = {"project_ref": project, "request_key": project, "token_hash": hash_token(bearer)}
+    response = await client.post("/v1/delegations/connections", json=body)
+    assert response.status_code == 201, response.text
+    replay = await client.post("/v1/delegations/connections", json=body)
+    assert replay.json() == response.json()
+    return bearer, response.json()
+
+
+async def test_two_projects_share_500_but_another_account_has_its_own(container, client):
+    grant, first = await managed(container, client)
+    secret_a, a = await root(client, "project-a")
+    secret_b, b = await root(client, "project-b")
+    assert a["member_id"] == b["member_id"] == first.member_id
+    assert a["connection_id"] != b["connection_id"]
+    client.headers["X-Sandbox-Subject"] = "account-b"
+    secret_c, c = await root(client, "project-c")
+    assert c["member_id"] != a["member_id"]
+    agents = []
+    for index, secret in enumerate((secret_a, secret_b, secret_c)):
+        principal = await container.tokens.authenticate(secret)
+        work = await container.delegation.ensure_work(
+            principal, work_ref="work", work_kind="experiment"
+        )
+        agent, _, _ = await assignment(container, principal, work, lease=f"lease-{index}")
+        agents.append(agent)
+
+    async def rent(agent, key):
+        offer = await container.providers.offer(
+            agent.namespace, provider="fake", offer_id="tiny:east"
+        )
+        # A $300 reservation exercises the real account-locked admission calculator.
+        offer = offer.model_copy(
+            update={"hourly_price": Money(currency="USD", amount=Decimal(300))}
+        )
+        return await container.registry.create(
+            namespace=agent.namespace,
+            member_id=agent.member_id,
+            grant_id=agent.token_id,
+            request=CreateSandboxRequest(
+                provider="fake", offer_id="tiny:east", lease_seconds=3600, idempotency_key=key
+            ),
+            offer=offer,
+            login_user="sandbox",
+        )
+
+    results = await asyncio.gather(
+        rent(agents[0], "a"), rent(agents[1], "b"), return_exceptions=True
+    )
+    assert sum(isinstance(r, ValidationError) for r in results) == 1, results
+    assert sum(not isinstance(r, Exception) for r in results) == 1, results
+    await rent(agents[2], "c")
+    allowance = await client.get("/v1/delegations/allowance")
+    assert allowance.status_code == 200
+    member_budget = next(b for b in allowance.json()["budgets"] if b["scope"] == "member")
+    assert Decimal(member_budget["cap"]) == 500
+    assert Decimal(member_budget["reserved"]) == 300
+    # A root cannot change payer/namespace, set policy, or authorize a different project work.
+    client.headers.clear()
+    client.headers["Authorization"] = "Bearer " + secret_a
+    assert (
+        await client.post(
+            "/v1/delegations/connections",
+            json={
+                "project_ref": "escaped",
+                "request_key": "escaped",
+                "token_hash": hash_token("escaped"),
+            },
+        )
+    ).status_code == 403
+    # Revoking the issuing application also revokes descendants for admission.
+    await container.tokens.revoke(grant.token_id)
+    with pytest.raises(AuthorizationError):
+        await container.tokens.authenticate(secret_a)
+    with pytest.raises(AuthorizationError):
+        await container.tokens.authenticate("sbxt_lease-0")
+
+
+async def test_managed_issuance_requires_opt_in_and_bound_authority(container, client):
+    grant, _ = await managed(container, client)
+    body = {"project_ref": "p", "request_key": "p", "token_hash": hash_token("sbxt_example")}
+    container.settings.managed_delegation_grants = ()
+    assert (await client.post("/v1/delegations/connections", json=body)).status_code == 403
+    container.settings.managed_delegation_grants = (grant.token_id,)
+    assert (
+        await client.post("/v1/delegations/connections", json={**body, "member_id": "other"})
+    ).status_code == 400
+    client.headers["X-Sandbox-Namespace"] = "foreign"
+    assert (await client.post("/v1/delegations/connections", json=body)).status_code == 403
+    client.headers["X-Sandbox-Namespace"] = "managed"
+    await container.tokens.revoke(grant.token_id)
+    assert (await client.post("/v1/delegations/connections", json=body)).status_code == 401
+
+
+async def test_same_application_name_is_not_a_managed_grant(container, client):
+    await managed(container, client)
+    other = await container.tokens.create(
+        namespace="other", application_id="merv-ml", open_subjects=True
+    )
+    client.headers.update(
+        {"Authorization": "Bearer " + other.secret, "X-Sandbox-Namespace": "other"}
+    )
+    response = await client.post(
+        "/v1/delegations/connections",
+        json={"project_ref": "p", "request_key": "p", "token_hash": hash_token("sbxt_other")},
+    )
+    assert response.status_code == 403
+
+
+async def test_managed_grant_requires_a_member_cap(container, client):
+    grant = await container.tokens.create(
+        namespace="uncapped", application_id="managed", open_subjects=True
+    )
+    container.settings.managed_delegation_grants = (grant.token_id,)
+    client.headers.update(
+        {
+            "Authorization": "Bearer " + grant.secret,
+            "X-Sandbox-Namespace": "uncapped",
+            "X-Sandbox-Subject": "owner",
+        }
+    )
+    response = await client.post(
+        "/v1/delegations/connections",
+        json={"project_ref": "p", "request_key": "p", "token_hash": hash_token("sbxt_uncapped")},
+    )
+    assert response.status_code == 400
+    assert "monthly member allowance" in response.text
diff --git a/docs/integration/delegation-contract.md b/docs/integration/delegation-contract.md
index a2937d4..30adcc9 100644
--- a/docs/integration/delegation-contract.md
+++ b/docs/integration/delegation-contract.md
@@ -43,3 +43,27 @@ Original work/member/namespace/producer records remain unchanged. The fresh root
 must pass current account/member/human authority checks. No machine, mutation,
 assignment, workflow or capture-list authority is transferred; a different payer
 account/application/project cannot recover these reads. The retired root stays revoked.
+
+
+## Managed application funding
+
+`POST /v1/delegations/connections` uses an existing consumption bearer with
+`X-Sandbox-Namespace` and `X-Sandbox-Subject`. Its exact token ID must be present in
+`SANDBOXES_MANAGED_DELEGATION_GRANTS` (a JSON array). Application names alone do not
+authorize managed funding. The body contains only `project_ref`, `request_key`, and
+`token_hash`; the reply has the normal connection receipt shape. Persist the
+request key and bearer before calling: an exact replay recovers the same root.
+
+The subject must identify the integrating application's account, shared by all
+of that account's projects. The root fixes that member and namespace. Managed
+roots inherit the approved grant's host-provider funding under infrastructure
+policies and require a finite, unfiltered USD monthly member allowance. Merv's
+configured allowance is $500/month. They preserve namespace ceilings through the
+same aggregate policy/resource checks used by ordinary consent. Descendants
+revalidate the issuing consumption grant on authentication and admission;
+revoking or expiring that grant disables the delegated authority as well.
+
+`GET /v1/delegations/allowance` accepts a connection bearer or application
+consumption bearer and returns `{budgets:[...]}` for its member and parent account,
+including accrued, reserved, available, and accounting-completeness fields. It
+does not expose other members' budget rows or authorize policy writes.
