diff --git a/control/src/merv_sandboxes/api/routes/delegations.py b/control/src/merv_sandboxes/api/routes/delegations.py
index f8a1709..2828a86 100644
--- a/control/src/merv_sandboxes/api/routes/delegations.py
+++ b/control/src/merv_sandboxes/api/routes/delegations.py
@@ -36,6 +36,43 @@ class ActionBody(Frozen):
     id: str = Field(min_length=1, max_length=48)
 
 
+class ManagedConnectionBody(Frozen):
+    project_ref: str = Field(min_length=1, max_length=256)
+    request_key: str = Field(min_length=1, max_length=256)
+    token_hash: str = Field(pattern=r"^[a-f0-9]{64}$")
+
+
+@router.post("/connections", status_code=201)
+async def managed_connection(
+    body: ManagedConnectionBody, container: ContainerDep, principal: PrincipalDep
+) -> dict[str, Any]:
+    # Namespace and payer come solely from the authenticated application grant;
+    # only operator-approved grant IDs gain managed host access; callers cannot
+    # set caps, choose another payer, or supply a delegation policy.
+    if principal.role != "consumer" or principal.grant_kind:
+        raise AuthorizationError("a managed application consumption grant is required")
+    return await container.delegation.create_connection(
+        principal,
+        application_id=principal.application_id,
+        project_ref=body.project_ref,
+        member_id=principal.member_id,
+        source_namespace=principal.namespace,
+        policy={},
+        request_key=body.request_key,
+        token_hash=body.token_hash,
+    )
+
+
+@router.get("/allowance")
+async def allowance(container: ContainerDep, principal: PrincipalDep) -> dict[str, Any]:
+    if principal.grant_kind:
+        async with container.db.transaction() as conn:
+            await container.delegation.root_in(conn, principal)
+    elif principal.role != "consumer" or not principal.application_id:
+        raise AuthorizationError("an application or connection credential is required")
+    return {"budgets": await container.delegation.allowance(principal)}
+
+
 @router.get("/connection")
 async def connection(container: ContainerDep, principal: PrincipalDep) -> dict[str, Any]:
     async with container.db.transaction() as conn:
