{
  "plugins": [
    {
      "id": "research",
      "name": "@merv/research"
    },
    {
      "id": "paper",
      "name": "@merv/paper"
    },
    {
      "id": "reflections",
      "name": "@merv/reflections"
    },
    {
      "id": "knowledge",
      "name": "@merv/knowledge"
    },
    {
      "id": "experiments",
      "name": "@merv/experiments"
    },
    {
      "id": "code-tools",
      "name": "@merv/code-research/tools",
      "required": false
    },
    {
      "id": "code-api",
      "name": "@merv/code-research/api",
      "required": false
    },
    {
      "id": "code-ui",
      "name": "@merv/code-research/ui",
      "required": false
    },
    {
      "id": "code-research",
      "name": "@merv/code-research",
      "required": false
    },
    {
      "id": "code",
      "name": "@merv/code",
      "config": {
        "repositories": {
          "root": "${directory}/code"
        }
      },
      "required": false
    },
    {
      "id": "api",
      "name": "@merv/api",
      "config": {
        "host": "${host}",
        "port": "${port}"
      }
    },
    {
      "id": "ui",
      "name": "@merv/ui",
      "required": false
    },
    {
      "id": "tools",
      "name": "@merv/api/tools-plugin"
    },
    {
      "id": "sessions",
      "name": "@merv/sessions"
    },
    {
      "id": "identity",
      "name": "@merv/identity",
      "config": {}
    },
    {
      "id": "feed",
      "name": "@merv/feed",
      "required": false
    },
    {
      "id": "tasks",
      "name": "@merv/tasks"
    },
    {
      "id": "reviews",
      "name": "@merv/reviews"
    },
    {
      "id": "context-builder",
      "name": "@merv/context-builder"
    },
    {
      "id": "artifacts",
      "name": "@merv/artifacts"
    },
    {
      "id": "workflows",
      "name": "@merv/workflows"
    },
    {
      "id": "scope",
      "name": "@merv/scope"
    },
    {
      "id": "blobs",
      "name": "@merv/blobs",
      "config": {
        "root": "${directory}/blobs"
      }
    },
    {
      "id": "domain-events",
      "name": "@merv/domain-events"
    },
    {
      "id": "state",
      "name": "@merv/state",
      "config": {
        "connectionStringEnv": "MERV_DB_URL",
        "schemaEnv": "MERV_DB_SCHEMA",
        "schema": "merv"
      }
    }
  ]
}
