{
  "plugins": [
    { "id": "board-tools", "name": "@merv/board/tools" },
    { "id": "board-ui", "name": "@merv/board/ui", "required": false },
    { "id": "board", "name": "@merv/board" },
    {
      "id": "board-app",
      "name": "@merv/board-app",
      "config": { "directory": "${directory}", "solo": false, "dailyUsdPerPerson": 5 }
    },
    { "id": "api", "name": "@merv/api", "config": { "host": "${host}", "port": "${port}" } },
    { "id": "ui", "name": "@merv/ui", "config": { "bundle": "board" } },
    { "id": "scope-tools", "name": "@merv/scope/tools" },
    { "id": "scope-api", "name": "@merv/scope/api" },
    { "id": "tools", "name": "@merv/api/tools-plugin" },
    {
      "id": "identity",
      "name": "@merv/identity",
      "config": {
        "supabaseUrl": "https://YOUR-PROJECT.supabase.co",
        "publishableKeyEnv": "BOARD_SUPABASE_PUBLISHABLE_KEY"
      }
    },
    { "id": "scope", "name": "@merv/scope" },
    { "id": "blobs", "name": "@merv/blobs", "config": { "root": "${directory}/blobs" } },
    {
      "id": "state",
      "name": "@merv/state",
      "config": {
        "connectionStringEnv": "MERV_DB_URL",
        "schemaEnv": "MERV_DB_SCHEMA",
        "schema": "board"
      }
    }
  ]
}
